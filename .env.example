# ===========================================
# Cloud Functions - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in the values

# Application
NODE_ENV=development
LOG_LEVEL=debug

# Webhook Secrets
# Add your webhook provider secrets here
# WEBHOOK_SECRET_EXAMPLE=whsec_your_secret_here
# WEBHOOK_SECRET_STRIPE=whsec_...
# WEBHOOK_SECRET_GITHUB=your_github_webhook_secret

# Extensions
# ALGOLIA_SYNC_API_KEY=your_custom_api_key_for_elastic_path
